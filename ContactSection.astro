---
---

<section class="contact" id="kontakt">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Współpraca</p>
      <h2 class="section-title">Kontakt</h2>
      <p class="section-desc">
        Zapraszamy do kontaktu w celu omówienia szczegółów współpracy.
      </p>
    </header>

    <div class="contact-grid">
      <div class="contact-cards">
        <div class="contact-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="card-label">Adres</p>
            <p class="card-value">
              ul. Lwowska 17<br />
              38-400 Krosno<br />
              woj. podkarpackie
            </p>
          </div>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.47 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.08 6.08l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <p class="card-label">Telefon</p>
            <a href="tel:+48793587177" class="card-value card-link">+48 793 587 177</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <p class="card-label">Email</p>
            <a href="mailto:bok@armanco.pl" class="card-value card-link">bok@armanco.pl</a>
          </div>
        </div>
      </div>

      <div class="contact-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2587.5!2d21.76!3d49.69!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473c5a5d0000000%3A0x0!2sul.%20Lwowska%2017%2C%2038-400%20Krosno!5e0!3m2!1spl!2spl!4v1699999999999!5m2!1spl!2spl"
          width="100%"
          height="100%"
          style="border:0; filter: grayscale(1) invert(0.9) contrast(0.85);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa - ARMANCO Krosno"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 7rem 0;
    background: var(--dark);
    position: relative;
  }

  .contact::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    min-height: 400px;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    background: var(--dark-2);
  }

  .contact-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 2rem 2rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }

  .contact-card:last-child { border-bottom: none; }
  .contact-card:hover { background: var(--dark-3); }

  .card-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: var(--gold);
    margin-top: 2px;
  }

  .card-icon svg { width: 100%; height: 100%; }

  .card-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .card-value {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.6;
  }

  .card-link {
    color: var(--text);
    transition: color 0.2s;
  }
  .card-link:hover { color: var(--gold); }

  .contact-map {
    background: var(--dark-3);
    min-height: 400px;
  }

  .contact-map iframe { display: block; }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-map { min-height: 280px; }
  }
</style>
