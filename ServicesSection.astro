---
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20M6 20V10l6-6 6 6v10M10 20v-5h4v5"/></svg>`,
    title: "Koparki",
    desc: "Profesjonalne usługi koparkowe dla każdego typu prac ziemnych.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/></svg>`,
    title: "Roboty Ziemne",
    desc: "Kompleksowe prace ziemne, wykopy, niwelacja terenu.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>`,
    title: "Kostka Brukowa",
    desc: "Układanie kostki brukowej — podjazdy, chodniki, tarasy.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22V12M12 12C12 12 8 10 6 7s0-6 3-6 4 2 3 5M12 12c0 0 4-2 6-5s0-6-3-6-4 2-3 5"/></svg>`,
    title: "Przyłącza",
    desc: "Wykonywanie przyłączy wodno-kanalizacyjnych i gazowych.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M9 21V7l3-4 3 4v14M3 21V11l3-3M21 21V11l-3-3"/></svg>`,
    title: "Fundamenty",
    desc: "Profesjonalne wykonanie fundamentów pod budynki.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>`,
    title: "Odwodnienia",
    desc: "Systemy odwodniające, drenaże, kanalizacja deszczowa.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M4.22 6.22l2.83 2.83M2 12h4M4.22 17.78l2.83-2.83M12 18v4M19.78 17.78l-2.83-2.83M22 12h-4M19.78 6.22l-2.83 2.83"/></svg>`,
    title: "Odśnieżanie",
    desc: "Zimowe utrzymanie dróg i placów, odśnieżanie.",
  },
];
---

<section class="services" id="uslugi">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Co oferujemy</p>
      <h2 class="section-title">Nasze Usługi</h2>
      <p class="section-desc">
        Oferujemy szeroki zakres profesjonalnych usług budowlanych i ziemnych
        dla klientów indywidualnych oraz firm.
      </p>
    </header>

    <div class="services-grid">
      {services.map((s, i) => (
        <article class="service-card" style={`--i:${i}`}>
          <div class="service-icon" set:html={s.icon} />
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 7rem 0;
    background: var(--dark-2);
    position: relative;
  }

  .services::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .service-card {
    background: var(--dark-2);
    padding: 2.5rem 2rem;
    transition: background 0.25s;
    position: relative;
    overflow: hidden;
  }

  .service-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 2px;
    background: var(--gold);
    transition: width 0.3s ease;
  }

  .service-card:hover { background: var(--dark-3); }
  .service-card:hover::after { width: 100%; }

  .service-icon {
    width: 40px;
    height: 40px;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .service-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .service-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .service-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
</style>
